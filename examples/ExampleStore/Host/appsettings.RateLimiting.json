{
  "Enabled": true,
  "GlobalPolicy": {
    "PermitLimit": 200,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AuthenticatedPolicy": {
    "PermitLimit": 500,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "EndpointOverrides": {
    "auth/login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "auth/forgot-password": {
      "PermitLimit": 3,
      "WindowSeconds": 300
    },
    "auth/refresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "RejectionStatusCode": 429,
  "RejectionMessage": "Too many requests. Please try again later."
}
